# Make Homebrew-managed tools available before ~/.extra runs.
if [ -x /opt/homebrew/bin/brew ]; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
	eval "$(/usr/local/bin/brew shellenv)"
fi

# User-local binaries: Poetry, Claude Code native install (self-updating).
# Must come after brew shellenv so ~/.local/bin wins over Homebrew shims.
export PATH="$HOME/.local/bin:$PATH"

export PATH="$HOME/.turso:$PATH"
